# Kompilator C i konsolidator
CCOMP = gcc
LOADER = gcc

# Opcje kompilacji
OPT = -g -DDEBUG
# OPT = -O3

# Naglowek procedur pomiarowych znajduje sie w sasiednim katalogu biblioteki
INC = -I../pomiar_czasu_lib

moj_program: moj_program.o pomiar_czasu.o
	$(LOADER) $(OPT) moj_program.o pomiar_czasu.o -o moj_program

moj_program.o: moj_program.c ../pomiar_czasu_lib/pomiar_czasu.h
	$(CCOMP) -c $(OPT) $(INC) moj_program.c

pomiar_czasu.o: pomiar_czasu.c ../pomiar_czasu_lib/pomiar_czasu.h
	$(CCOMP) -c $(OPT) $(INC) pomiar_czasu.c

clean:
	rm -f *.o moj_program wyniki_io.txt
